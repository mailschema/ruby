{
  "kind": "MapTypeContract",
  "id": "https://mailschema.org/types/action-approval",
  "version": "0.1",
  "profile": "https://mailschema.org/profiles/map/0.2",
  "target": "A proposed action at the exact revision the description names. The details state its terms.",
  "dependencies": [
    {
      "url": "https://mailschema.org/schemas/map-0.2.schema.json",
      "canonicalDigest": "sha-256:e7327bd379f75e62e9b6ea387ac80d470e1acf5b3c10060739f43231bfa373d3"
    }
  ],
  "detailsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "summary": {
        "$ref": "https://mailschema.org/schemas/map-0.2.schema.json#/$defs/nonBlank",
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "requester": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "https://mailschema.org/schemas/map-0.2.schema.json#/$defs/nonBlank",
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "id": {
            "$ref": "https://mailschema.org/schemas/map-0.2.schema.json#/$defs/httpsIdentifier"
          }
        },
        "required": ["name"]
      },
      "authorizationDetails": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "maxProperties": 50,
          "required": ["type"],
          "properties": {
            "type": {
              "$ref": "https://mailschema.org/schemas/map-0.2.schema.json#/$defs/nonBlank",
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "locations": {
              "type": "array",
              "items": {
                "$ref": "https://mailschema.org/schemas/map-0.2.schema.json#/$defs/identifier"
              },
              "maxItems": 100,
              "uniqueItems": true
            },
            "actions": {
              "type": "array",
              "items": {
                "$ref": "https://mailschema.org/schemas/map-0.2.schema.json#/$defs/nonBlank",
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "maxItems": 100,
              "uniqueItems": true
            },
            "datatypes": {
              "type": "array",
              "items": {
                "$ref": "https://mailschema.org/schemas/map-0.2.schema.json#/$defs/nonBlank",
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "maxItems": 100,
              "uniqueItems": true
            },
            "identifier": {
              "$ref": "https://mailschema.org/schemas/map-0.2.schema.json#/$defs/nonBlank",
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "privileges": {
              "type": "array",
              "items": {
                "$ref": "https://mailschema.org/schemas/map-0.2.schema.json#/$defs/nonBlank",
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "maxItems": 100,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "required": ["summary", "authorizationDetails"]
  },
  "requestSchema": {
    "url": "https://mailschema.org/schemas/action-approval-0.1.schema.json",
    "canonicalDigest": "sha-256:601dfe4a21dfe2fb50954f7b54ee3b02580595f76b05ad9dafe1d7c6c137cec3"
  },
  "operations": [
    {
      "id": "approve",
      "effect": "Approve the proposal on the terms in its details, or propose approval for a human decision.",
      "authority": ["credential"],
      "consequences": ["authorization", "commitment", "disclosure"],
      "results": [
        {
          "state": "completed",
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "decision": {
                "const": "approved"
              }
            },
            "required": ["decision"]
          }
        },
        {
          "state": "approval-required",
          "outputSchema": {
            "type": "object",
            "additionalProperties": false
          }
        },
        {
          "state": "failed",
          "reasons": ["declined", "stale-target", "expired", "superseded", "withdrawn"],
          "outputSchema": {
            "type": "object",
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "decline",
      "effect": "Decline the proposal. The service records the decision and does not run the action.",
      "authority": ["credential"],
      "consequences": ["refusal"],
      "results": [
        {
          "state": "completed",
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "decision": {
                "const": "declined"
              }
            },
            "required": ["decision"]
          }
        }
      ]
    }
  ]
}
