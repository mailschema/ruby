{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailschema.org/schemas/content-review-0.3.schema.json",
  "title": "Content Review 0.3 request",
  "allOf": [
    {
      "$ref": "https://mailschema.org/schemas/map-0.2.schema.json#/$defs/request"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "object",
          "properties": {
            "id": {
              "const": "https://mailschema.org/types/content-review"
            },
            "version": {
              "const": "0.3"
            }
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "request-changes"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "feedback": {
                  "$ref": "https://mailschema.org/schemas/map-0.2.schema.json#/$defs/nonBlank",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                }
              },
              "required": ["feedback"]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "approve"
            },
            "input": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      ]
    }
  ]
}
