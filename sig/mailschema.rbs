# Mail Action Protocol 0.3 processing.
module Mailschema
  type json = Hash[String, untyped] | Array[untyped] | String | Integer | Float | bool | nil
  type document = Hash[String, untyped]
  type capability_kind = { effects: Array[String], max_lifetime_seconds: Integer }

  VERSION: String

  PROFILE: String
  CONTEXT: String
  DESCRIPTION_MEDIA_TYPE: String
  DESCRIPTION_MAX_BYTES: Integer
  CONTRACT_MAX_BYTES: Integer
  MAX_DEPTH: Integer
  EFFECTS: String
  FORMATS: Array[String]
  CAPABILITY_KINDS: Hash[String, capability_kind]

  # A document that is not MAP JSON, or not the document it claims to be.
  class InvalidDocument < StandardError
    attr_reader errors: Array[String]

    def initialize: (String message, ?Array[String] errors) -> void
  end

  def self.parse: (String input, Integer max_bytes) -> json
  def self.canonicalize: (json value) -> String
  def self.digest: (json value) -> String

  def self.description_errors: (untyped value) -> Array[String]
  def self.parse_description: (String input) -> document

  def self.contract_errors: (untyped value) -> Array[String]

  def self.implementation_errors: (untyped value) -> Array[String]
  def self.parse_implementation: (String input) -> document

  # A valid contract with its digest and compiled schemas.
  class Contract
    attr_reader document: document
    attr_reader digest: String

    def self.parse: (String input) -> Contract

    def initialize: (untyped value) -> void
    def id: () -> String
    def version: () -> String
    def operation: (String id) -> document?
    def details_errors: (untyped details) -> Array[String]
    def input_errors: (String operation_id, ?untyped input) -> Array[String]
    def description_errors: (untyped description) -> Array[String]
  end

  # The MAP part of an email.
  module Message
    class Result < Data
      attr_reader status: :none | :invalid | :valid
      attr_reader reason: Symbol?
      attr_reader description: document?

      def self.new: (Symbol status, Symbol? reason, document? description) -> instance
                  | (status: Symbol, reason: Symbol?, description: document?) -> instance
    end

    NONE: Result

    # `mail` is a Mail::Message read from the received bytes.
    def self.extract: (untyped mail) -> Result

    # Returns a Mail::Part.
    def self.part: (document description) -> untyped
  end

  # Core "Qualifying message authentication" over a DKIM verifier's facts.
  module Authentication
    class Signature < Data
      attr_reader pass: bool
      attr_reader domain: String
      attr_reader body_length_limited: bool
      attr_reader algorithm: String
      attr_reader key_type: String
      attr_reader key_bits: Integer
      attr_reader signed_headers: Array[String]

      def self.new: (bool pass, String domain, bool body_length_limited, String algorithm, String key_type,
                     Integer key_bits, Array[String] signed_headers) -> instance
                  | (pass: bool, domain: String, body_length_limited: bool, algorithm: String, key_type: String,
                     key_bits: Integer, signed_headers: Array[String]) -> instance

      def pass?: () -> bool
      def body_length_limited?: () -> bool
    end

    REQUIRED: Array[String]
    CONDITIONAL: Array[String]

    def self.qualifying: (raw_message: String, signatures: Array[Signature],
                          ?organizational_domain: ^(String) -> String?) -> Signature?
  end
end
