        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 100
        },
        "contributor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
